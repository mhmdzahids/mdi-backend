# ================================================================
# Dimsum Factory MES & POS Backend Environment Configuration
# ================================================================

# Environment Mode: 'development' | 'production' | 'staging'
# CATATAN: Pada mode 'production', fitur /auth/quick-switch dan /dev/wipe-database dinonaktifkan secara ketat.
APP_ENV=development
PORT=8000

# Database Connection (Async SQLite atau PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./dimsum.db
# PostgreSQL alternatif:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dimsum_db

# JWT Secret Key (WAJIB diubah menggunakan secret random 64-karakter hex di production)
# Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# Internal Service Master API Key
API_KEY=change-this-to-a-secure-master-api-key

# PIN Otorisasi Darurat Supervisor (4-6 digit angka, wajib diubah dari default)
SUPERVISOR_PIN=8888

# API Key untuk Sinkronisasi Client Toko Online (Public Buyer API)
# Raw key diberikan kepada client website; backend menyimpan hash SHA-256 pada pos_api_keys
BUYER_CLIENT_API_KEY=mdi_live_change_me_to_random_token

# Paywuz Payment Gateway (QRIS & Virtual Account)
PAYWUZ_API_KEY=pk_sand_e65dd0378cfaf7f87e6e80aa5d33ab59
PAYWUZ_API_URL=https://api.paywuz.id/v1
# Webhook Secret untuk validasi HMAC-SHA256 signature saat payment settlement callback
PAYWUZ_WEBHOOK_SECRET=change-this-to-your-paywuz-webhook-secret

# CORS Whitelist (URL frontend React MDI)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
